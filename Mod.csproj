<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>GiganteCode</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameVer Condition="'$(GameVer)' == ''">23</GameVer>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Survivalcraft">
      <HintPath>Survivalcraft$(GameVer).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Engine">
      <HintPath>Engine$(GameVer).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
